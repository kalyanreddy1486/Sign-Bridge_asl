# Copy this file to .env and edit as needed.
# web_server.py reads these at startup.

# Host to bind. Use 0.0.0.0 to accept connections from other devices on
# your LAN, or 127.0.0.1 to keep it local-only.
HOST=0.0.0.0

# Port to serve on. Cloud platforms (Heroku, Render, Railway) set this
# automatically; leave blank and they will inject it.
PORT=5000

# Set to "true" for Flask debug mode during local development only.
DEBUG=false
